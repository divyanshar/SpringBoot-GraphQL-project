type Employee {
    id: ID!
    name: String!
    email: String!
    department: String
    salary: Float
}

input EmployeeInput {
    name: String!
    email: String!
    department: String
    salary: Float!
}

type Query {
    employees: [Employee!]!
    employee(id: ID!): Employee
}

type Mutation {
    createEmployee(input: EmployeeInput!): Employee!
}